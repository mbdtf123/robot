# ============================================================
# 机器人项目 .gitignore
# 适用：PlatformIO + ESP-IDF(ESP32-S3) + MATLAB + VS Code
# ============================================================

# ---------- PlatformIO 构建产物 ----------
.pio/
.pioenvs/
.piolibdeps/
compile_commands.json

# ---------- ESP-IDF / CMake 构建产物 ----------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
*.obj
*.o
*.a
*.elf
*.bin
*.map

# 说明：sdkconfig.esp32-s3-devkitc-1 目前是特意提交的
# 如果以后不想跟踪它，取消下面一行的注释即可
# sdkconfig.esp32-s3-devkitc-1

# ---------- VS Code 本机配置 ----------
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/*.log

# ---------- MATLAB 自动生成文件 ----------
*.asv
*.m~
*.autosave
slprj/
*.slxc

# ---------- Python（如有脚本） ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 操作系统 / 编辑器临时文件 ----------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
.idea/

# ---------- 本机工具运行态 ----------
# DSH 连接 MATLAB 的运行态目录（MCP Server 临时文件 + MATLAB 预置项）
.dsh-matlab/
